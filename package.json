{
  "name": "tg-bid-monitor",
  "version": "1.0.0",
  "description": "Telegram广告竞价监控",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "prestart": "cd src/web/v2 && npm install --silent && npm run build",
